{
  "persistent_volumes": [
    "neo4j_data",
    "neo4j_logs",
    "embedding_ollama_data"
  ],
  "default_embedding_model": "nomic-embed-text",
  "internal_http_port": 3000,
  "memory_limits": {
    "mirofish": "2g",
    "neo4j": "2g",
    "embedding-ollama": "1536m"
  },
  "service_stop_order": [
    "mirofish",
    "embedding-ollama",
    "neo4j"
  ],
  "forbidden_compose_actions": [
    "down",
    "rm",
    "-v",
    "pull",
    "up",
    "--build"
  ]
}
