# =============================================================
# MiroFish Online Configuration
# =============================================================
# Copy this file to .env and adjust values for your setup.
# The chat endpoint may be local or hosted. Hosted providers receive topic data.
# =============================================================

# A real environment variable always wins over a value in this file, so compose
# and shell exports are not silently overridden.

# ===== Local development server =====
# Debug is off by default. Turning it on enables the Werkzeug debugger, which
# runs code submitted from the browser — keep it bound to loopback only.
# FLASK_DEBUG=true
# FLASK_HOST defaults to 127.0.0.1; set 0.0.0.0 only on a trusted network.
# FLASK_HOST=0.0.0.0
# FLASK_PORT defaults to 5001.
# FLASK_PORT=5001
# Only used if Flask sessions or CSRF are ever introduced; nothing signs cookies
# today. Set it anyway in any shared deployment.
# SECRET_KEY=replace-me
# Start refusing mutating /api requests until an operator resumes the service.
# The RS2000 profile sets this to true so an on-demand start is deliberate.
# MIROFISH_START_DRAINED=false

# ===== LLM Configuration (OpenAI-compatible format) =====
# Example below points to local Ollama. Replace all three values together when
# using a hosted OpenAI-compatible provider.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b
# Alternative local model for development:
# LLM_MODEL_NAME=qwen2.5:14b

# ===== Audience Panel: model routing =====
# Comma-separated pool the 20 personas are assigned from, deterministically by
# seed. A persona's model_hint is honoured only when it appears in this pool.
# MIROFISH_AUDIENCE_MODEL_POOL=gemma4:31b
#
# Model used to retry a persona that failed with invalid JSON, a schema error, a
# truncated answer or a low-quality response. It MUST differ from every entry in
# the pool, otherwise the persona is retried on the model that just failed and
# the rescue path never runs. The receipt reports this as
# model_routing.high_quality_retry_available.
#
# Criteria for putting a model here, from the measured bake-offs: zero schema
# fallbacks across a batch and full reaction coverage. As of 2026-07-08 only
# deepseek-v4-pro cleared both (12/12 green, 240/240 reactions, 0 fallbacks).
# MIROFISH_AUDIENCE_RETRY_MODEL=deepseek-v4-pro

# ===== Audience Panel: run limits =====
# A run calls one model per persona. Defaults shown; the API caps workers at 6.
# MIROFISH_AUDIENCE_MAX_WORKERS=10
# MIROFISH_AUDIENCE_CALL_TIMEOUT_SECONDS=45
# MIROFISH_AUDIENCE_RUN_TIMEOUT_SECONDS=210
# Share of personas allowed to fail before the run is rejected outright.
# MIROFISH_AUDIENCE_FAILURE_THRESHOLD=0.30
# How many finished run records stay in memory for status lookups.
# MIROFISH_AUDIENCE_MAX_TERMINAL_RECORDS=64
# 'auto' uses Neo4j when it initialised and the in-process store otherwise;
# 'memory' demands the in-process store, which is what the test suite uses.
# Runs written to the in-process store are lost when the process restarts.
# MIROFISH_AUDIENCE_STORE=auto

# ===== Optional per-task model overrides =====
# All default to LLM_MODEL_NAME when unset.
# MIROFISH_JSON_MODEL=
# MIROFISH_NER_MODEL=
# MIROFISH_REPORT_MODEL=
# MIROFISH_REPAIR_MODEL=
# Context window sent to Ollama. Prevents prompt truncation on long documents.
# OLLAMA_NUM_CTX=8192

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration =====
# Uses Ollama's embedding endpoint
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# For Docker: EMBEDDING_BASE_URL=http://ollama:11434

# ===== Optional OASIS / CAMEL-AI Configuration =====
# Off by default. Turning this on registers /api/graph, /api/simulation and
# /api/report; with it off only /api/audience exists (15 routes instead of 74).
#
# The variable alone is not enough: camel-oasis is no longer part of the default
# install, so a working simulation lane also needs `uv sync --extra simulator`.
# MIROFISH_ENABLE_SIMULATION=false
#
# The simulation lane is NOT in the default install. camel-oasis and camel-ai
# live in the `simulator` extra, so the production image -- built with
# `uv sync --frozen --no-dev`, which takes no extras -- deliberately omits them.
# That is what keeps torch and the nvidia-*-cu12 wheels out: measured locally,
# the venv drops from 859 MB to 93 MB, and more on linux/amd64 where those
# wheels actually apply.
#
# Nothing under backend/app imports camel, so the app runs either way; only the
# simulation subprocesses need it. To run them: uv sync --extra simulator
#
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL.
# Keep these aligned with the endpoint selected for simulation experiments.
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1
# Rounds of the multi-agent social simulation.
# OASIS_DEFAULT_MAX_ROUNDS=10
# Report agent: tool calls and reflection rounds per report, and its sampling
# temperature. Only used by the document-graph lane.
# REPORT_AGENT_MAX_TOOL_CALLS=5
# REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
# REPORT_AGENT_TEMPERATURE=0.5

# ===== Docker-mode overrides =====
# Uncomment these when running ALL services inside Docker
# (backend container talks to neo4j/ollama containers by service name)
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
